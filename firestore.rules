rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Any authenticated user can read profiles (needed for Settings members list).
    // Only the owner can write their own doc.
    match /users/{userId} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Top-level invite tokens — any authenticated user can look up or consume a token
    match /invites/{token} {
      allow read, delete: if request.auth != null;
      allow create, update: if request.auth != null;
    }

    match /households/{householdId} {
      allow read: if request.auth != null;

      // Existing members can make any update.
      // Non-members can join by adding only themselves (invite acceptance).
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.members
        || (
          request.resource.data.members.hasAll(resource.data.members) &&
          request.resource.data.members.size() == resource.data.members.size() + 1 &&
          request.auth.uid in request.resource.data.members
        )
      );

      allow delete: if request.auth != null
        && request.auth.uid in resource.data.members;

      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.members;

      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null
          && request.auth.uid in
             get(/databases/$(database)/documents/households/$(householdId)).data.members;
      }
    }
  }
}
